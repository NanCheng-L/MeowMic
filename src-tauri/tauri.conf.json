{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeowMic",
  "version": "0.2.10",
  "identifier": "com.asus.meowmic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MeowMic",
        "width": 420,
        "height": 680,
        "resizable": true,
        "maximized": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/models/*",
      "resources/vb-cable/*",
      "resources/deepfilter/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/NanCheng-L/MeowMic/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBNDQyNjU5NTAzOTcxNjIKUldSaWNUbFFXU1pFeXN6SnR3VXZJNHVRaEU0K3FXb3FYYkZGcDZGbUtBM1pSODdCY2VuS3J0cDUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
